# PostgreSQL (used by docker-compose for the postgres service)
POSTGRES_USER=guzopay
POSTGRES_PASSWORD=guzopay
POSTGRES_DB=guzopay

# Backend — libpq-style DSN (Compose sets host=postgres inside the stack)
DATABASE_URL=host=postgres user=guzopay password=guzopay dbname=guzopay port=5432 sslmode=disable

# Optional: browser-facing API URLs (defaults in frontends: http://localhost:8080 / ws://localhost:8080)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
VITE_VEHICLE_CODE=4A2Q
