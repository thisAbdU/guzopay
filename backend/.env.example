# Safaricom Ethiopia Daraja sandbox — copy to .env (never commit .env)
CONSUMER_KEY=
CONSUMER_SECRET=
ENVIRONMENT=SANDBOX

# From portal / sandbox app (docs samples: 802000, 443443, 1020)
MPESA_SHORTCODE=
MPESA_PASSKEY=

# B2C payout (from portal / simulator)
MPESA_INITIATOR_NAME=apitest
MPESA_SECURITY_CREDENTIAL=

# Public HTTPS base for webhooks (ngrok / cloudflare tunnel)
# Example: https://abc123.ngrok-free.app
CALLBACK_BASE_URL=

PORT=8080
